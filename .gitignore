.venv/
.venv-extension/
__pycache__/
*.py[cod]
*.egg-info/
build/
qa/
# Cache bytes are included locally for offline reproduction, not tracked by default.
lab/**/cache/
lab/t2_data/raw/
lab/**/raw/
lab/**/structures/
lab/**/*.sqlite*
lab/**/processed/
lab/research/
lab/verification/
lab/verification_v05/
*.aux
*.out
*.log
*.fls
*.fdb_latexmk
# Keep the article's actual executed logs trackable.
!evidence/*.log

# Evaluation downloads stay local; pinned source URLs are tracked.
evaluation/data/cache/

# Fresh replay trees are distinct from archived article evidence.
reproductions/
# Licensed numerical data are intentional tracked inputs.
!data/experimental/pr2026/*.out

# Retain the executed Bradley observable-case test logs.
!evidence/bradley2022/*.log

# Native run records and RNG traces are retained in the checked ZIP archives.
evaluation/results/validation_extension/selected/*/runs/
evaluation/results/validation_extension/selected/*/traces/
!evidence/validation_extension/*.log
